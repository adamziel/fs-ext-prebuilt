{
	"name": "fs-ext-extra-prebuilt",
	"description": "Fork of fs-ext with prebuilt binaries and Windows LockFileEx support.",
	"keywords": [
		"fs",
		"filesystem",
		"flock",
		"seek",
		"lockfileex",
		"prebuilt"
	],
	"version": "2.2.4",
	"homepage": "https://github.com/adamziel/fs-ext-prebuilt",
	"repository": {
		"type": "git",
		"url": "git://github.com/adamziel/fs-ext-prebuilt.git"
	},
	"author": "WordPress Playground team",
	"contributors": [
		"Matt Sergeant <helpme@gmail.com> (http://baudehlo.wordpress.com/)"
	],
	"main": "fs-ext.js",
	"files": [
		"fs-ext.js",
		"load-prebuilt.js",
		"install.js",
		"binaries/",
		"binding.gyp",
		"fs-ext.cc",
		"LICENSE.txt"
	],
	"engines": {
		"node": ">= 8.0.0"
	},
	"dependencies": {
		"nan": "^2.24.0"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/adamziel/fs-ext-prebuilt/issues"
	},
	"scripts": {
		"prebuilds": "node ./prebuildify.js",
		"install": "node ./install.js",
		"test": "node ./run_tests && npm run test:jest",
		"test:jest": "jest tests/fcntl-range-locks.test.js",
		"lint": "node ./node_modules/eslint/bin/eslint \"*.js\" \"tests/**/*.js\""
	},
	"devDependencies": {
		"eslint": "^5.9.0",
		"jest": "^29.7.0",
		"node-abi": "^3.85.0",
		"node-gyp": "^11.2.0",
		"prebuildify": "^6.0.1"
	}
}
